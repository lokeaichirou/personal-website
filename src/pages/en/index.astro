---
const title = 'LI Mou';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="LI Mou is a machine learning research engineer working across mobility data, recommendation systems, privacy-preserving learning, and multimodal AI."
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Instrument+Serif:ital@0;1&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="site-shell">
      <div class="cover" aria-hidden="true"></div>
      <div class="cover-wash" aria-hidden="true"></div>

      <header class="site-header">
        <button class="monogram" type="button" data-view="home" aria-label="LI Mou home">LM<span>.</span></button>
        <nav class="section-tabs" aria-label="Page sections">
          <button type="button" class="tab" data-view="experience" aria-selected="false">Experience</button>
          <button type="button" class="tab" data-view="projects" aria-selected="false">Projects</button>
          <button type="button" class="tab" data-view="contact" aria-selected="false">Contact</button>
        </nav>
        <div class="language-switcher" aria-label="Language">
          <button type="button" data-language="en" aria-pressed="true">EN</button>
          <button type="button" data-language="fr" aria-pressed="false">FR</button>
          <button type="button" data-language="zh" aria-pressed="false">CN</button>
        </div>
      </header>

      <section class="home-view view is-active" data-panel="home" aria-labelledby="home-title">
        <div class="home-copy">
          <h1 id="home-title" data-copy="home.name">LI Mou</h1>
          <p class="role" data-copy="home.role">Algorithm Engineer</p>
        </div>
        <p class="location" data-copy="home.location">Grenoble, France · Available for research and ML collaborations</p>
      </section>

      <section class="content-view view" data-panel="experience" aria-live="polite"></section>
      <section class="content-view view" data-panel="projects" aria-live="polite"></section>
      <section class="content-view view" data-panel="contact" aria-live="polite"></section>

      <footer class="site-footer">
        <span>© 2026 LI Mou</span>
        <a href="https://github.com/lokeaichirou" target="_blank" rel="noreferrer">GitHub &#8599;</a>
        <a href="https://www.linkedin.com/in/mou-li-01333a292/" target="_blank" rel="noreferrer">LinkedIn &#8599;</a>
      </footer>
    </main>

    <script>
      const copy = {
        en: {
          tabs: { experience: 'Experience', projects: 'Projects', contact: 'Contact' },
          home: {
            name: 'LI Mou',
            role: 'Algorithm Engineer',
            location: 'Grenoble, France · Available for research and ML collaborations',
          },
          experience: {
            kicker: 'Selected experience',
            title: 'Research depth, production discipline.',
            items: [
              {
                period: 'Nov 2024 - Present',
                role: 'Machine Learning and Algorithm Engineer',
                company: 'DiDi Global · Overseas Business',
                place: 'Beijing, China',
                text: 'Own end-to-end applied ML for pick-up, drop-off, and location-naming recommendation across global markets, supporting about 15M daily completed orders.',
                points: ['Built Spark and Hive feature and training-data pipelines with SLA and data-quality checks.', 'Connected Flink and Kafka real-time updates to online inference features.', 'Improved key business metrics by 0.5pp and reduced case occurrence by 0.06pp.'],
              },
              {
                period: 'Feb 2023 - Apr 2024',
                role: 'Research Engineer, Machine Learning and Privacy-Preserving Learning',
                company: 'Inria · TRUMPET Project',
                place: 'Lille, France',
                text: 'Designed privacy-preserving modules spanning differential privacy, federated learning, and survival analysis.',
                points: ['Balanced privacy guarantees and utility for ML and database queries.', 'Investigated PySyft, FATE, and Flower for federated learning.'],
              },
              {
                period: 'Oct 2021 - Aug 2022',
                role: 'Data Scientist, Recommendation Systems',
                company: 'Baidu, Inc.',
                place: 'Beijing, China',
                text: 'Developed and optimized large-scale recommendation-system tasks for Baidu FEED.',
                points: [],
              },
            ],
            skills: 'Core stack',
            skillList: ['Python', 'Scala', 'Spark', 'Flink', 'Kafka', 'Hive', 'PyTorch', 'TensorFlow', 'SQL', 'LLM / RAG'],
          },
          projects: {
            kicker: 'Open work',
            title: 'Experiments with an implementation behind them.',
            source: 'Open on GitHub',
            items: [
              { kind: 'LLM / RAG / Agents', title: 'Document QA experiments', text: 'LlamaIndex agents with Query Fusion retrieval, BGE reranking, question condensation, and regression-oriented prompt iteration.', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/LlammaIndex', tags: ['LlamaIndex', 'Query Fusion', 'Reranking'] },
              { kind: 'Information retrieval', title: 'Retrieval fusion pipeline', text: 'Experimental RAG pipeline combining Elasticsearch, vector stores, reciprocal-rank fusion, and CrossEncoder reranking.', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/rag_and_llm_embeddings', tags: ['Elasticsearch', 'Vector search', 'RRF'] },
              { kind: 'Computer vision', title: 'Deep-learning phase retrieval', text: 'Nonlinear neural networks for the ill-posed phase-retrieval problem in X-ray phase-contrast imaging.', href: 'https://github.com/lokeaichirou/deep-learning-based-phase-retrieval-for-X-ray-imaging-tomography', tags: ['PyTorch', 'Imaging', 'Research'] },
            ],
          },
          contact: {
            kicker: 'Get in touch',
            title: 'Let’s discuss a problem worth solving.',
            note: 'For research, applied ML, or recommendation-system conversations.',
            email: 'Write an email',
            social: 'Professional links',
            based: 'Based in Grenoble, France',
          },
        },
        fr: {
          tabs: { experience: 'Parcours', projects: 'Projets', contact: 'Contact' },
          home: {
            name: 'LI Mou',
            role: 'Ingénieur algorithmes',
            location: 'Grenoble, France · Ouvert aux collaborations de recherche et de ML',
          },
          experience: {
            kicker: 'Parcours sélectionné',
            title: 'Rigueur de recherche, exigence de production.',
            items: [
              { period: 'Nov. 2024 - Aujourd’hui', role: 'Ingénieur Machine Learning et Algorithmes', company: 'DiDi Global · Activité internationale', place: 'Pékin, Chine', text: 'Je pilote le ML appliqué de bout en bout pour les recommandations de points de prise en charge, destination et nommage des lieux, sur plusieurs marchés et environ 15 M de courses quotidiennes.', points: ['Pipelines Spark et Hive pour les features et données d’entraînement, avec SLA et contrôles qualité.', 'Mises à jour temps réel Flink et Kafka connectées aux features d’inférence.', 'Amélioration de 0,5 point des indicateurs clés et réduction de 0,06 point du taux de cas.'] },
              { period: 'Fév. 2023 - Avr. 2024', role: 'Ingénieur de recherche, ML et apprentissage préservant la confidentialité', company: 'Inria · Projet TRUMPET', place: 'Lille, France', text: 'Conception de modules préservant la confidentialité pour la privacy différentielle, l’apprentissage fédéré et l’analyse de survie.', points: ['Équilibre entre garanties de confidentialité et utilité pour le ML et les requêtes de base de données.', 'Étude de PySyft, FATE et Flower pour l’apprentissage fédéré.'] },
              { period: 'Oct. 2021 - Fév. 2022', role: 'Data Scientist, systèmes de recommandation', company: 'Baidu, Inc.', place: 'Pékin, Chine', text: 'Développement et optimisation de systèmes de recommandation à grande échelle pour Baidu FEED.', points: [] },
            ],
            skills: 'Technologies clés',
            skillList: ['Python', 'Scala', 'Spark', 'Flink', 'Kafka', 'Hive', 'PyTorch', 'TensorFlow', 'SQL', 'LLM / RAG'],
          },
          projects: {
            kicker: 'Travaux ouverts',
            title: 'Des expérimentations avec une vraie implémentation.',
            source: 'Ouvrir sur GitHub',
            items: [
              { kind: 'LLM / RAG / Agents', title: 'Expériences de QA documentaire', text: 'Agents LlamaIndex avec retrieval Query Fusion, reranking BGE, condensation des questions et itération de prompts basée sur des tests de régression.', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/LlammaIndex', tags: ['LlamaIndex', 'Query Fusion', 'Reranking'] },
              { kind: 'Recherche d’information', title: 'Pipeline de fusion de retrieval', text: 'Pipeline RAG expérimental associant Elasticsearch, vector stores, fusion par rang réciproque et reranking CrossEncoder.', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/rag_and_llm_embeddings', tags: ['Elasticsearch', 'Recherche vectorielle', 'RRF'] },
              { kind: 'Vision par ordinateur', title: 'Restitution de phase par deep learning', text: 'Réseaux neuronaux non linéaires pour le problème mal posé de restitution de phase en imagerie X par contraste de phase.', href: 'https://github.com/lokeaichirou/deep-learning-based-phase-retrieval-for-X-ray-imaging-tomography', tags: ['PyTorch', 'Imagerie', 'Recherche'] },
            ],
          },
          contact: { kicker: 'Contact', title: 'Échangeons sur un problème qui mérite d’être résolu.', note: 'Pour un échange sur la recherche, le ML appliqué ou les systèmes de recommandation.', email: 'Écrire un email', social: 'Liens professionnels', based: 'Basé à Grenoble, France' },
        },
        zh: {
          tabs: { experience: '经历', projects: '项目', contact: '联系' },
          home: { name: '李谋', role: '算法工程师', location: '法国格勒诺布尔 · 开放研究与机器学习合作' },
          experience: {
            kicker: '工作经历',
            title: '研究深度，工程落地。',
            items: [
              { period: '2024 年 11 月 - 至今', role: '机器学习与算法工程师', company: '滴滴全球化业务', place: '中国北京', text: '负责上车点、下车点和地点命名推荐的端到端应用机器学习迭代，服务全球多个市场、约 1500 万日完成订单。', points: ['构建 Spark 和 Hive 特征及训练数据管道，并配置 SLA 和数据质量检查。', '通过 Flink 和 Kafka 将实时更新接入在线推理特征。', '核心业务指标提升 0.5pp，case 发生率降低 0.06pp。'] },
              { period: '2023 年 2 月 - 2024 年 4 月', role: '机器学习与隐私保护学习研究工程师', company: 'Inria · TRUMPET 项目', place: '法国里尔', text: '为差分隐私、联邦学习和生存分析设计隐私保护模块。', points: ['在机器学习和数据库查询中平衡隐私保障与效用。', '调研 PySyft、FATE 和 Flower 等联邦学习框架。'] },
              { period: '2021 年 10 月 - 2022 年 9 月', role: '推荐系统数据科学家', company: '百度', place: '中国北京', text: '为百度 FEED 开发并优化大规模推荐系统任务。', points: [] },
            ],
            skills: '核心技术栈',
            skillList: ['Python', 'Scala', 'Spark', 'Flink', 'Kafka', 'Hive', 'PyTorch', 'TensorFlow', 'SQL', 'LLM / RAG'],
          },
          projects: {
            kicker: '开源项目',
            title: '每个实验都有可以运行的实现。',
            source: '在 GitHub 打开',
            items: [
              { kind: 'LLM / RAG / Agent', title: '文档问答实验', text: '基于 LlamaIndex 的 Agent，结合 Query Fusion 检索、BGE 重排序、多轮问题压缩和回归测试驱动的提示词迭代。', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/LlammaIndex', tags: ['LlamaIndex', 'Query Fusion', '重排序'] },
              { kind: '信息检索', title: '检索融合管道', text: '结合 Elasticsearch、向量库、倒数排名融合和 CrossEncoder 重排序的实验性 RAG 管道。', href: 'https://github.com/lokeaichirou/LLM/tree/main/Projects/rag_and_llm_embeddings', tags: ['Elasticsearch', '向量检索', 'RRF'] },
              { kind: '计算机视觉', title: '深度学习相位恢复', text: '针对 X 射线相位衬度成像中病态相位恢复问题的非线性神经网络方案。', href: 'https://github.com/lokeaichirou/deep-learning-based-phase-retrieval-for-X-ray-imaging-tomography', tags: ['PyTorch', '医学成像', '研究'] },
            ],
          },
          contact: { kicker: '联系我', title: '一起讨论值得解决的问题。', note: '欢迎交流研究、应用机器学习或推荐系统相关话题。', email: '发送邮件', social: '职业主页', based: '现居法国格勒诺布尔' },
        },
      };

      const panel = document.querySelector('.content-view[data-panel="experience"]');
      const panels = [...document.querySelectorAll('.view')];
      const tabs = [...document.querySelectorAll('.tab')];
      const languageButtons = [...document.querySelectorAll('[data-language]')];
      let language = localStorage.getItem('li-mou-language') || 'en';

      const escape = (value) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character]);
      const list = (items) => items.map((item) => `<li>${escape(item)}</li>`).join('');

      function renderExperience(content) {
        return `<div class="panel-inner experience-panel">
          <header class="panel-header"><p class="eyebrow">${escape(content.kicker)}</p><h2>${escape(content.title)}</h2></header>
          <div class="timeline">${content.items.map((item) => `<article class="timeline-item">
            <p class="period">${escape(item.period)}</p>
            <div><h3>${escape(item.role)}</h3><p class="company">${escape(item.company)}</p><p class="place">${escape(item.place)}</p></div>
            <div class="timeline-detail"><p>${escape(item.text)}</p>${item.points.length ? `<ul>${list(item.points)}</ul>` : ''}</div>
          </article>`).join('')}</div>
          <div class="skill-block"><p class="eyebrow">${escape(content.skills)}</p><div class="skills">${content.skillList.map((skill) => `<span>${escape(skill)}</span>`).join('')}</div></div>
        </div>`;
      }

      function renderProjects(content) {
        return `<div class="panel-inner projects-panel">
          <header class="panel-header"><p class="eyebrow">${escape(content.kicker)}</p><h2>${escape(content.title)}</h2></header>
          <div class="project-grid">${content.items.map((item, index) => `<article class="project-card">
            <span class="project-number">0${index + 1}</span><p class="project-kind">${escape(item.kind)}</p><h3>${escape(item.title)}</h3><p>${escape(item.text)}</p>
            <div class="tags">${item.tags.map((tag) => `<span>${escape(tag)}</span>`).join('')}</div>
            <a href="${escape(item.href)}" target="_blank" rel="noreferrer">${escape(content.source)} <b aria-hidden="true">↗</b></a>
          </article>`).join('')}</div>
        </div>`;
      }

      function renderContact(content) {
        return `<div class="panel-inner contact-panel">
          <div class="portrait-wrap"><img src="/images/li-mou.jpg" alt="LI Mou" /></div>
          <div class="contact-copy"><p class="eyebrow">${escape(content.kicker)}</p><h2>${escape(content.title)}</h2><p class="contact-note">${escape(content.note)}</p>
            <a class="email" href="mailto:arshavin23@sina.com">arshavin23@sina.com <b aria-hidden="true">↗</b></a>
            <div class="contact-links"><p class="eyebrow">${escape(content.social)}</p><a href="https://www.linkedin.com/in/mou-li-01333a292/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://github.com/lokeaichirou" target="_blank" rel="noreferrer">GitHub ↗</a></div>
            <p class="based">${escape(content.based)}</p>
          </div>
        </div>`;
      }

      function render(languageCode) {
        const content = copy[languageCode];
        document.documentElement.lang = languageCode === 'zh' ? 'zh-CN' : languageCode;
        document.querySelectorAll('[data-copy]').forEach((element) => {
          const [section, key] = element.dataset.copy.split('.');
          element.textContent = content[section][key];
        });
        tabs.forEach((tab) => { tab.textContent = content.tabs[tab.dataset.view]; });
        document.querySelector('.content-view[data-panel="experience"]').innerHTML = renderExperience(content.experience);
        document.querySelector('.content-view[data-panel="projects"]').innerHTML = renderProjects(content.projects);
        document.querySelector('.content-view[data-panel="contact"]').innerHTML = renderContact(content.contact);
        languageButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.language === languageCode)));
      }

      function selectView(view) {
        panels.forEach((item) => item.classList.toggle('is-active', item.dataset.panel === view));
        tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.view === view)));
        document.querySelector('.site-shell').classList.toggle('showing-home', view === 'home');
      }

      document.querySelectorAll('[data-view]').forEach((button) => button.addEventListener('click', () => selectView(button.dataset.view)));
      languageButtons.forEach((button) => button.addEventListener('click', () => {
        language = button.dataset.language;
        localStorage.setItem('li-mou-language', language);
        render(language);
      }));

      render(language);
      selectView('home');
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { background: #152c2e; }
  body { margin: 0; font-family: 'DM Sans', 'Noto Sans SC', sans-serif; color: #ecf0e7; }
  button, a { color: inherit; font: inherit; }
  button { cursor: pointer; }
  a { text-decoration: none; }

  .site-shell { min-height: 100vh; position: relative; isolation: isolate; overflow: hidden; background: #152c2e; }
  .cover, .cover-wash { position: fixed; inset: 0; z-index: -2; }
  .cover { background: #152c2e url('/images/cover.jpg') center 60% / cover no-repeat; }
  .cover-wash { z-index: -1; background: linear-gradient(105deg, rgba(8, 24, 25, 0.82) 0%, rgba(12, 33, 34, 0.51) 44%, rgba(9, 26, 25, 0.2) 100%); }
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 28px; padding: 24px clamp(22px, 4.6vw, 74px); border-bottom: 1px solid rgba(239, 245, 229, 0.38); }
  .monogram { width: fit-content; padding: 0; border: 0; background: transparent; font-family: 'Instrument Serif', serif; font-size: 38px; line-height: 0.8; }
  .monogram span { color: #ff8468; }
  .section-tabs { display: flex; align-items: center; gap: 26px; }
  .tab, .language-switcher button { padding: 4px 0; border: 0; border-bottom: 1px solid transparent; background: transparent; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.045em; text-transform: uppercase; }
  .tab:hover, .tab[aria-selected='true'] { border-color: #ff8468; color: #ffb6a4; }
  .language-switcher { justify-self: end; display: flex; gap: 11px; }
  .language-switcher button { color: rgba(241, 245, 236, 0.72); }
  .language-switcher button[aria-pressed='true'] { color: #fff; border-color: #fff; }

  .view { display: none; }
  .view.is-active { display: block; }
  .home-view { min-height: calc(100vh - 152px); padding: clamp(70px, 12vh, 140px) clamp(22px, 10vw, 160px) 50px; position: relative; }
  .home-copy { max-width: 730px; }
  .eyebrow { margin: 0; color: #c6df8d; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { letter-spacing: 0; }
  h1 { margin: 19px 0 14px; font-family: 'Instrument Serif', serif; font-size: clamp(70px, 9vw, 138px); font-weight: 400; line-height: 0.8; }
  .role { margin-bottom: 0; color: #dce8cc; font-size: clamp(17px, 1.8vw, 24px); font-weight: 500; line-height: 1.25; }
  .location { position: absolute; right: clamp(22px, 4.6vw, 74px); bottom: 28px; max-width: 260px; margin-bottom: 0; text-align: right; font-family: 'DM Mono', monospace; font-size: 9px; line-height: 1.55; letter-spacing: 0.04em; text-transform: uppercase; }

  .content-view { min-height: calc(100vh - 82px); padding: 44px clamp(22px, 6vw, 100px) 96px; overflow: auto; background: rgba(17, 43, 43, 0.96); }
  .panel-inner { max-width: 1300px; margin: 0 auto; animation: enter 380ms ease both; }
  @keyframes enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .panel-header { display: grid; grid-template-columns: minmax(160px, 0.4fr) minmax(0, 1.5fr); gap: 30px; align-items: start; margin: 29px 0 62px; }
  h2 { max-width: 770px; margin-bottom: 0; font-family: 'Instrument Serif', serif; font-size: clamp(52px, 6.5vw, 100px); font-weight: 400; line-height: 0.85; }
  .timeline { display: grid; gap: 13px; }
  .timeline-item { display: grid; grid-template-columns: 145px minmax(260px, 0.95fr) minmax(280px, 1.05fr); gap: 30px; padding: 27px 29px 30px; border: 1px solid #58706c; background: rgba(34, 72, 70, 0.64); }
  .timeline-item:first-child { border-color: #9ab47c; background: #1c4641; }
  .period, .place, .project-kind, .project-number { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.035em; text-transform: uppercase; }
  .period, .place { color: #b5c5be; }
  .timeline h3 { margin-bottom: 8px; font-size: clamp(20px, 2vw, 28px); font-weight: 500; line-height: 1.08; }
  .company { margin-bottom: 11px; color: #ff967d; font-size: 14px; font-weight: 700; line-height: 1.35; }
  .place { margin-bottom: 0; }
  .timeline-detail > p { margin-bottom: 15px; color: #edf2e9; font-size: 14px; line-height: 1.52; }
  .timeline-detail ul { display: grid; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .timeline-detail li { position: relative; padding-left: 16px; color: #cdd8d2; font-size: 13px; line-height: 1.42; }
  .timeline-detail li::before { content: '>'; position: absolute; left: 0; color: #ff967d; font-family: 'DM Mono', monospace; }
  .skill-block { display: grid; grid-template-columns: 145px 1fr; gap: 30px; margin-top: 34px; padding: 22px 29px; border: 1px solid #58706c; background: rgba(34, 72, 70, 0.35); }
  .skills, .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .skills span, .tags span { border: 1px solid #70857e; padding: 6px 8px; font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 0.025em; text-transform: uppercase; }

  .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .project-card { min-height: 410px; display: flex; flex-direction: column; position: relative; padding: 27px 26px 25px; border-top: 5px solid #789e75; background: #eaf1dd; color: #15302f; }
  .project-card:nth-child(2) { border-top-color: #d16b4d; background: #f5ebd7; }
  .project-card:nth-child(3) { border-top-color: #5d8990; background: #e0eff0; }
